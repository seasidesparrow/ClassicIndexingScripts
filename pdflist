#!/bin/sh
#
# $Id: pdflist,v 1.1 2012/06/27 01:37:54 alberto Exp alberto $
#
# Creates two lists from the list of PDFs that 
# are in the ADS article archive:
#
#   1. borne-digital PDFs.  These are typically generated by
#      a publisher then given to use for inclusion in our system.
#      They have text and graphics that can be easily
#      extracted via 'pdftext' and 'pdfimages'
#
#   2. ADS-generated bw + color/grayscale PDFs.  We detect these
#      by looking for an image stream in the PDF file with
#      more than 1 bits/pixel
# 
# $Log: pdflist,v $
# Revision 1.1  2012/06/27 01:37:54  alberto
# Initial revision
#
#

p=`basename $0`

# set environment for kubernetes containerization
# The container image must have an abbreviated .adsrc file in /app

[ "x$ADS_ENVIRONMENT" = "x" ] && [ -x "/app/.adsrc" ] && eval `/app/.adsrc sh`

warn () {
    echo "$p: $@" 1>&2
}
die () {
    echo "$p: $@" 1>&2
    exit 1
}

root_dir="$ADS_ARTICLES/bitmaps"
cd $root_dir || die "cannot cd to $root_dir"

# structure is:
#    type/jnl/vol/PDF/file.pdf
# e.g.
#    seri/ApJ../0004/PDF/1896ApJ.....4..324J.pdf
#

if [ $# -gt 0 ] ; then
    echo "$@" | xargs -n 1
else 
    find `cat pubtypes.list` pdfs -mindepth 3 -maxdepth 4 -type f -name '*.pdf' -print
fi | \
    perl -ne '
        chop;
        my $file = $_;
        my $bibcode = (split(/\//,$file))[-1];
        $bibcode =~ s/\.pdf//;
        $bibcode =~ s/\+/&/g;  
        if (length($bibcode) != 19 and $bibcode !~ /^\d{4}/) {
            warn "skipping non-bibcode file $file\n";
            next;
        }
        open(my $fh, $file);
        unless ($fh) {
             warn "cannot open file $file: $!";
             next;
        }
        # default assumptions:
        my $rgb = 0;   # no color
        my $gray = 0;  # binary (1 bit/pixel)
        my $ads = 0;   # not ADS-generated
        while (<$fh>) {
            if (m{/BitsPerComponent (\d+)} and $1 > 1) {
                $gray = 1;
                # warn "found bitspercomponent: $1";         
            } elsif (m{/ColorSpace\s*/DeviceRGB}) {
                $rgb = 1;
                # warn "found devicegray";
            } elsif (m{^/ADSSum\s+}) {
                $ads = 1;
                # warn "found adssum";
            }
        }
        my $origin = "PUB";
        if ($ads) {
           $origin = "ADS";
        }
        my $color = "BW";
        if ($rgb) { 
            $color = "RGB";
        } elsif ($gray) {
            $color = "GRAY";
        }
        print "$bibcode\t$file\t$origin\t$color\n";
'
